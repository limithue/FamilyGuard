<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃卡片（Regular 材质）
  结构：外暗边 → 半透明主体 → 上缘定向高光 → 底部内阴影 → 色散描边
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 外轮廓：向下偏移 1dp 的冷色暗边，制造玻璃厚度 -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A22406B" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. 主体：更通透，上亮下暗，露出背后光晕 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#66FFFFFF"
                android:endColor="#3DE4EEFF"
                android:startColor="#A6FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 3. 上缘定向高光（光源左上）：玻璃顶部的亮带 -->
    <item
        android:gravity="top"
        android:height="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#7AFFFFFF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>

    <!-- 4. 底部内阴影：下沉感与厚度 -->
    <item
        android:gravity="bottom"
        android:height="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#293B5675"
                android:startColor="#00FFFFFF" />
            <corners
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="22dp" />
        </shape>
    </item>

    <!-- 5. 色散描边：外层冷紫、内层白光，模拟边缘色散 -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#4D8FA9FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:bottom="0.7dp"
        android:left="0.7dp"
        android:right="0.7dp"
        android:top="0.7dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.8dp"
                android:color="#99FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
