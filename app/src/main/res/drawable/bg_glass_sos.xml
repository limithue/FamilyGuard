<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃 SOS 圆钮：红色玻璃 + 上缘高光 + 外缘透镜环 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#D9C81E1E"
                android:startColor="#F2FF6B6B"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
