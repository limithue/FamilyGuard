<?xml version="1.0" encoding="utf-8"?>
<!-- 小尺寸液态玻璃卡（功能入口/统计）：与主卡片同材质，圆角略小 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A22406B" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#66FFFFFF"
                android:endColor="#3DE4EEFF"
                android:startColor="#A6FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:height="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#7AFFFFFF" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#293B5675"
                android:startColor="#00FFFFFF" />
            <corners
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#4D8FA9FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
